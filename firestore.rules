rules_version = '2';

// Cloud save (src/cloud/firestore.ts): every player can read and write only their own documents.
//   users/{uid}             { updatedAt, saveVersion, session }
//   users/{uid}/save/{key}  { json }
// Social (src/cloud/social.ts):
//   seasons/{YYYY-MM}/aiRanked/{uid}  { name, avatar, portrait, rank, crownPoints, score, wins, updatedAt }  public read
//   seasons/{YYYY-MM}/ranked/{uid}    { name, avatar, portrait, rating, wins, updatedAt }                   public read
//   profiles/{uid}                    { name, avatar, portrait, friendCode, level?, title?, cardsOwned?, cardsTotal?, updatedAt }
//   friendCodes/{CODE}                { uid }
//   friendRequests/{from}_{to}        { from, to, fromName, fromAvatar, createdAt }
//   users/{uid}/friends/{friendUid}   { since }
//   presence/{uid}                    { lastSeen, inMatch }
//   invites/{to}/items/{id}           { from, fromName, code, createdAt, status }
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validName(v) {
      return v is string && v.size() > 0 && v.size() <= 20;
    }

    function shortString(v) {
      return v is string && v.size() <= 40;
    }

    // Leaderboards: only the current UTC month can be written.
    function isCurrentSeason(season) {
      return season.matches('^[0-9]{4}-[0-9]{2}$')
        && int(season.split('-')[0]) == request.time.year()
        && int(season.split('-')[1]) == request.time.month();
    }

    function validEntryCommon(d) {
      return validName(d.name)
        && shortString(d.avatar)
        && shortString(d.portrait)
        && d.wins is int && d.wins >= 0 && d.wins <= 100000
        && d.updatedAt == request.time;
    }

    function validAiEntry(d) {
      return d.keys().hasOnly(['name', 'avatar', 'portrait', 'rank', 'crownPoints', 'score', 'wins', 'updatedAt'])
        && d.keys().hasAll(['name', 'avatar', 'portrait', 'rank', 'crownPoints', 'score', 'wins', 'updatedAt'])
        && validEntryCommon(d)
        && d.rank is int && d.rank >= 0 && d.rank <= 15
        && d.crownPoints is int && d.crownPoints >= 0 && d.crownPoints <= 99999
        && (d.rank == 15 || d.crownPoints == 0)
        && d.score == d.rank * 100000 + d.crownPoints;
    }

    function validRankedEntry(d) {
      return d.keys().hasOnly(['name', 'avatar', 'portrait', 'rating', 'wins', 'updatedAt'])
        && d.keys().hasAll(['name', 'avatar', 'portrait', 'rating', 'wins', 'updatedAt'])
        && validEntryCommon(d)
        && d.rating is int && d.rating >= 100 && d.rating <= 4000;
    }

    // Public profile stats (optional: profiles written by older versions don't have them).
    function validProfileStats(d) {
      return (!('level' in d) || (d.level is int && d.level >= 1 && d.level <= 100))
        && (!('title' in d) || d.title == null || shortString(d.title))
        && (!('cardsOwned' in d) || (d.cardsOwned is int && d.cardsOwned >= 0 && d.cardsOwned <= 5000))
        && (!('cardsTotal' in d) || (d.cardsTotal is int && d.cardsTotal >= 0 && d.cardsTotal <= 5000))
        && (!('cardsOwned' in d) || ('cardsTotal' in d && d.cardsOwned <= d.cardsTotal));
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['updatedAt', 'saveVersion', 'session']);

      match /save/{key} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && key in ['meta', 'profile', 'collection', 'decks', 'matches', 'progress']
          && request.resource.data.keys().hasOnly(['json'])
          && request.resource.data.json is string
          && request.resource.data.json.size() < 900000;
      }

      // Friends list. A friendship is written by the player who accepts a request, into both
      // lists, and only while that request exists ({from}_{to}).
      match /friends/{fid} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid) || isOwner(fid);
        allow create: if request.resource.data.keys().hasOnly(['since'])
          && request.resource.data.since == request.time
          && (
            (isOwner(uid) && exists(/databases/$(database)/documents/friendRequests/$(fid + '_' + uid)))
            || (isOwner(fid) && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + fid)))
          );
      }
    }

    match /seasons/{season}/{board}/{uid} {
      allow read: if true;
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && isCurrentSeason(season)
        && ((board == 'aiRanked' && validAiEntry(request.resource.data))
          || (board == 'ranked' && validRankedEntry(request.resource.data)));
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'portrait', 'friendCode', 'level', 'title', 'cardsOwned', 'cardsTotal', 'updatedAt'])
        && validName(request.resource.data.name)
        && shortString(request.resource.data.avatar)
        && shortString(request.resource.data.portrait)
        && validProfileStats(request.resource.data)
        && request.resource.data.friendCode is string
        && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // Codes are looked up one at a time (get), never listed; a code can't be taken over.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && code.matches('^[A-HJKMNP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{id} {
      allow read, delete: if signedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'fromAvatar', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && validName(request.resource.data.fromName)
        && shortString(request.resource.data.fromAvatar)
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.to)/friends/$(request.auth.uid));
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['lastSeen', 'inMatch'])
        && request.resource.data.lastSeen == request.time
        && request.resource.data.inMatch is bool;
    }

    // Match invites: only a player on the recipient's friends list can send one; the recipient
    // reads, accepts (status) or deletes (declines) it; the sender can watch and withdraw it.
    match /invites/{to}/items/{id} {
      allow read: if signedIn()
        && (request.auth.uid == to || resource == null || resource.data.from == request.auth.uid);
      allow delete: if signedIn()
        && (request.auth.uid == to || resource.data.from == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'code', 'createdAt', 'status'])
        && request.resource.data.from == request.auth.uid
        && validName(request.resource.data.fromName)
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Z0-9]{4,8}$')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(to)/friends/$(request.auth.uid));
      allow update: if isOwner(to)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
    }
  }
}
